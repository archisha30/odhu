# Copy this file to .env and fill in your real keys. Never commit .env.

# Gnani (Prisma STT + Timbre TTS). One key covers both. Sent as the X-API-Key-ID header.
GNANI_API_KEY=your-gnani-api-key

# Google Gemini (vision + reasoning). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated, tried in order if the main model fails (quota used up, overloaded,
# timeout). Free-tier quotas are per model, so more models = more free requests per day.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.6-flash

# Timbre v3.0 voice. Every v3.0 voice speaks both Kannada and Hindi.
# Options: Avinash, Chetana, Devansh, Harshad, Kalpana, Lakshmi, Prakash,
#          Riyaa, Shivani, Shubham, Tarika, Vasudha, Yashraj
TTS_VOICE=Shivani

# Gnani credits left when this database started counting. /api/usage subtracts every
# call made since. Each laptop has its own database, so a teammate's calls aren't
# included: the Gnani dashboard is the real source of truth.
GNANI_CREDIT_BUDGET=5000

# Speech speed. Gnani allows 0.85 (slow) to 1.15 (fast). 0.9 is easier for elderly listeners.
TTS_SPEED=0.9
